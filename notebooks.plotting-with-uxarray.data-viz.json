"raster-vs-vector-polygons","label":"Raster vs Vector Polygons","html_id":"raster-vs-vector-polygons","implicit":true,"key":"zBZQnqBBh8"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"By default, polygon rasterization is enabled (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dZDrvtFXoX"},{"type":"inlineCode","value":"rasterize=True","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ahXoFJq0Xr"},{"type":"text","value":"). This setting optimizes performance by converting vector polygons into a raster format when rendering. For high-resolution grids, maintaining rasterization is strongly recommended, as rendering individual vector polygons can significantly impact performance.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DSXW8SeQvk"}],"key":"Kry7Jvkljy"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Disabling rasterization (","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"tyHoxHDIV9"},{"type":"inlineCode","value":"rasterize=False","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Wb2Wp5c9Kq"},{"type":"text","value":") switches to direct vector polygon rendering, which may be suitable for simpler visualizations where maintaining vector properties is essential.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"UA6yDTB9Gz"}],"key":"vGXp51aiga"}],"key":"X3YkQzYgVR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"uxds[\"bottomDepth\"].plot.polygons(rasterize=False)","key":"uN8gGyASxR"},{"type":"outputs","id":"q5PxN5nTzXl6ZNBtE__Nm","children":[],"key":"lPvGO7Yjr6"}],"key":"DJvKyyeftJ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Vector polygon plots maintain complete data fidelity regardless of zoom level, preserving both accuracy and visual quality throughout any magnification. This characteristic distinguishes them from rasterized alternatives, which may show pixelation upon close inspection.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LnWquhvlyy"}],"key":"sTLpLVZE6j"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The following visualization demonstrates this advantage. When examining a magnified region of our grid, the vector-rendered polygons maintain their crisp definition and precise data representation.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sLH5ap39EW"}],"key":"bbmPsJA7Zn"}],"key":"RChx7nqNPH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"(\n    uxds[\"bottomDepth\"].plot.polygons(\n        rasterize=False, xlim=(-20, 0), ylim=(-5, 5), title=\"Vector Polygons\"\n    )\n    + uxds[\"bottomDepth\"].plot.polygons(\n        rasterize=True, xlim=(-20, 0), ylim=(-5, 5), title=\"Raster Polygons\"\n    )\n).cols(1)","key":"rPQcv9Yhhu"},{"type":"outputs","id":"BdRfg83cUIqt5ylvhhK3I","children":[],"key":"eRoBx63IvF"}],"key":"kvxTzLglOk"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Handling Periodic Elements","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"o0ajtTLVm9"}],"identifier":"handling-periodic-elements","label":"Handling Periodic Elements","html_id":"handling-periodic-elements","implicit":true,"key":"kJD7bzu4o8"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Visualizing unstructured grids on a spherical surface presents unique challenges, particularly when dealing with the antimeridian (180° longitude). This longitudinal line, where the Eastern and Western hemispheres meet, requires special consideration to ensure accurate 2D visualization of data that crosses this boundary.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"XW2ThXBqGg"}],"key":"uTt8joSoZg"},{"type":"image","url":"/unstructured-grid-viz-cookbook/build/Earth_map_with_180th-46306094558a89f1b867f092b4ad21ff.jpg","alt":"Antimeridian Example","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"kv8giSuAy0","urlSource":"../../_static/images/Earth_map_with_180th_meridian.jpg"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"UXarray addresses this challenge through its ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"bUcvGkVWEg"},{"type":"inlineCode","value":"periodic_elements","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"FDt1VWidS5"},{"type":"text","value":" parameter in polygon plotting functions. This parameter offers three approaches for managing faces that intersect with the antimeridian:","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"m3godUyyqt"}],"key":"Midn7XYmvv"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"inlineCode","value":"periodic_elements='exclude'","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"x2uqLPGBkd"},{"type":"text","value":" (Default)\nFaces that cross the antimeridian are masked, removing them from the visualization. While this approach may omit some data, it offers optimal performance and is recommended for most use cases.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"oDl5UMRDe6"}],"key":"JGnII5aORk"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"inlineCode","value":"periodic_elements='split'","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"aFXHz1coJO"},{"type":"text","value":"\nFaces that cross the antimeridian are divided, ensuring complete data representation. However, this processing step impacts the initial plotting time.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"BtlqdgCChV"}],"key":"zMLV14nJT4"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"inlineCode","value":"periodic_elements='ignore'","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"bRK4CJXCUX"},{"type":"text","value":"\nFaces that cross the antimeridian are not processed.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"yuU7hi1waL"}],"key":"Az78ioMwiW"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"For optimal visualization performance, we recommend maintaining the default ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"OGh0NWw4PW"},{"type":"inlineCode","value":"periodic_elements='exclude'","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"xCWaPsNIe6"},{"type":"text","value":" setting unless complete data representation at the antimeridian is essential for your specific analysis.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"Vz3UbmE9gN"}],"key":"IO4y3DCakQ"}],"key":"CjZmZokHAd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"(\n    uxds[\"bottomDepth\"].plot.polygons(\n        periodic_elements=\"exclude\", title=\"periodic_elements='exclude'\"\n    )\n    + uxds[\"bottomDepth\"].plot.polygons(\n        periodic_elements=\"split\", title=\"periodic_elements='split'\"\n    )\n).cols(1)","key":"KADonMStGl"},{"type":"outputs","id":"OmxaK6wBeF-Jr_TLrNmWY","children":[],"key":"Bqb4AZ1jeP"}],"key":"QowKMYcqwv"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"When working with data near or across the antimeridian (180° longitude), selecting an appropriate projection becomes crucial for accurate visualization. For comprehensive guidance on handling such scenarios, including recommended projections and geographic features, please refer to the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BvHjEmxX0a"},{"type":"link","url":"/notebooks/plotting-with-uxarray/geo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Geographic Projections & Features","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TQmJWjrnUH"}],"urlSource":"geo","dataUrl":"/notebooks.plotting-with-uxarray.geo.json","internal":true,"protocol":"file","key":"bJq05diUOG"},{"type":"text","value":" notebook.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vo2lqLRKOE"}],"key":"Eoe9A9GTfr"}],"key":"wyHq6MJX3L"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Polygon Plots for Node/Edge Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CDm4tKvv4n"}],"identifier":"polygon-plots-for-node-edge-data","label":"Polygon Plots for Node/Edge Data","html_id":"polygon-plots-for-node-edge-data","implicit":true,"key":"my7Tla9jWX"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Polygon plots require face-centered data variables, as each polygon must be rendered with a single value. This limitation presents a challenge when working with node-centered or edge-centered data, requiring a conversion process to map the data to faces.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"oYaRiNkG59"}],"key":"F9i5Toohoc"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"One effective approach is to perform topological averaging. This method calculates the mean value of adjacent nodes or edges and assigns the result to each face, creating a face-centered representation suitable for polygon visualization. While this transformation may introduce some averaging effects, it provides a practical solution for visualizing node and edge data within the constraints of polygon plotting.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"S1eqreCgvr"}],"key":"WFss2hBr0o"}],"key":"YGlXnEbMaz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"grid_path = \"../../meshfiles/hex.grid.nc\"\ndata_path = \"../../meshfiles/hex.node.data.nc\"\n\nuxds_node_centered = ux.open_dataset(grid_path, data_path)","key":"V24Pb2J0bx"},{"type":"outputs","id":"hEcvEsEjtCFFYk65JSJ03","children":[],"key":"qZMguN9fL0"}],"key":"X0aWXe9dxz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"uxds_node_centered[\"random_data_node\"].topological_mean(destination=\"face\").plot()","key":"cZu40EmPLR"},{"type":"outputs","id":"pezc0CTJEJmUkCTLKjLmC","children":[],"key":"XOQmaE8Ofi"}],"key":"eJQsQYk6jL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Points","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"u5R7RgmjYG"}],"identifier":"points","label":"Points","html_id":"points","implicit":true,"key":"tZqvsI7Qto"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Points provide an alternative visualization method that offers flexibility across different data mappings. This approach maps data values to specific coordinates, enabling visualization of node-centered, edge-centered, or face-centered data.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"s4kf8zHFDw"}],"key":"WQJguhlH81"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"The following visualization demonstrates this technique using face-centered data. Each point corresponds to a face center coordinate and displays its associated data value. This method maintains data fidelity while presenting the information in a discrete, coordinate-based format.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"APQEVNkaJj"}],"key":"xRozS6uCt6"}],"key":"uTa6myoKgx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"uxds[\"bottomDepth\"].plot.points()","key":"sRoaYupj8T"},{"type":"outputs","id":"9kRypQFY47cjly-1N417W","children":[],"key":"GXI9nmreXt"}],"key":"iVGNYf8GZ3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Rasterization","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JuT8vyFA25"}],"identifier":"rasterization","label":"Rasterization","html_id":"rasterization","implicit":true,"key":"GClsAF0nu9"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"As with polygon-based visualizations, point-based plots support rasterization through the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zXaeufCNqG"},{"type":"inlineCode","value":"rasterize=True","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LkRVuBRpnq"},{"type":"text","value":" parameter. This optimization technique converts vector-based points into a raster format during rendering.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bkPZZX3L1y"}],"key":"RFFn3A6ke6"}],"key":"YLmKjElDFT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"uxds[\"bottomDepth\"].plot.points(rasterize=True)","key":"CGgLHAdMiZ"},{"type":"outputs","id":"cAa-pinOogoHvaCNu_J4U","children":[],"key":"ONYxlW8V9a"}],"key":"cKNx3KOeKT"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Point-based rasterization demonstrates different characteristics across varying data resolutions. For coarse-resolution data like our example, point-based visualization produces notably lower visual quality compared to polygon-based approaches.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wYAoj4WoQ9"}],"key":"uT9sivIEBr"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"However, rasterized point plots emerge as a valuable tool for high-resolution grid visualization, offering significant performance advantages. For detailed information about leveraging this technique with high-resolution data, please refer to the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uL8h0xEIYJ"},{"type":"link","url":"/notebooks/plotting-with-uxarray/high-res","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Visualizing High-Resolution Grids","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CZUCIyHmH7"}],"urlSource":"high-res","dataUrl":"/notebooks.plotting-with-uxarray.high-res.json","internal":true,"protocol":"file","key":"JXSZzGCFNs"},{"type":"text","value":" section.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kjLzav5w7p"}],"key":"c3AGRAMzIG"}],"key":"rNFLts9FBa"}],"key":"NyXviWMuYr"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Grid Visualization","url":"/notebooks/plotting-with-uxarray/grid-viz","group":"Plotting with UXarray"},"next":{"title":"Geographic Projections & Features","url":"/notebooks/plotting-with-uxarray/geo","group":"Plotting with UXarray"}}},"domain":"http://localhost:3000"}