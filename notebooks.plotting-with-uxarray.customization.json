ations to meet your specific requirements.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"BA0ECjEJYZ"}],"key":"DvHPrjOn4g"}],"key":"IYjwvklEPT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Selecting a Renderer","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"snoLwVzYhn"}],"identifier":"selecting-a-renderer","label":"Selecting a Renderer","html_id":"selecting-a-renderer","implicit":true,"key":"L6TSlbgL3y"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"One key advantage is the flexibility to choose your preferred plotting backend. While Bokeh serves as the default renderer, you can easily switch to Matplotlib by specifying the backend parameter in your plotting commands. This allows you to leverage the unique strengths of each renderer – Bokeh’s interactive features or Matplotlib’s publication-quality static plots.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"H3FityzL2x"}],"key":"qygBPTdgbZ"}],"key":"JlmjUgp0cB"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2025-01-08T22:51:49.546061Z","start_time":"2025-01-08T22:51:46.731861Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"hv.extension(\"bokeh\")\nuxds[\"bottomDepth\"].plot()\n\n# can also do the following\n# uxds[\"bottomDepth\"].plot(backend='bokeh')","key":"mrvf5cDvdu"},{"type":"outputs","id":"g4wlxWrNnBX0TPgb_6Ggx","children":[],"key":"x1OcgtOXnP"}],"key":"Sfla2FuwtW"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2025-01-08T22:51:50.542797Z","start_time":"2025-01-08T22:51:49.739176Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"hv.extension(\"matplotlib\")\nuxds[\"bottomDepth\"].plot()\n\n